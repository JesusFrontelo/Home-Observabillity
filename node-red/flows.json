    {
        "id": "b4540717096431ed",
        "type": "function",
        "z": "57ad255b75a78a1a",
        "name": "Lambda function prometheus metrics generator",
        "func": "//let metrics = [];\n\n//for (const [key, value] of Object.entries(global.get(\"modbusData\") || {})) {\n//    const metricName = `modbus_${key.replace(/ /g, '_').toLowerCase()}`;\n//    metrics.push(`# HELP ${metricName} Help for ${key}`);\n//    metrics.push(`# TYPE ${metricName} gauge`);\n//    metrics.push(`${metricName}{fabricante=\"Ingeteam\",modelo=\"Ingecon Sun Storage 1 Play TL M\",origen=\"ModBus TCP/IP\"} ${value}`);\n//}\n\n//msg.payload = metrics.join(\"\\n\");\n//return msg;\n\n//for (const [key, value] of Object.entries(global.get(\"modbusData\") || {})) {\n//    const metricName = `modbus_${key.replace(/ /g, '_').toLowerCase()}`;\n//    const metric = `\n//# HELP ${metricName} Help for ${key}\n//# TYPE ${metricName} gauge\n//${metricName}{fabricante=\"Ingeteam\",modelo=\"Ingecon Sun Storage 1 Play TL M\",origen=\"ModBus TCP/IP\"} ${value}\n//    `;\n//    node.send({ payload: metric });\n//}\n\n//return null; // No retornar un mensaje principal, ya que estamos usando node.send\n\nlet metrics = [];\n\nfor (const [key, value] of Object.entries(global.get(\"modbusData\") || {})) {\n    // Crear la métrica\n    const metricName = `modbus_${key.replace(/ /g, '_').toLowerCase()}`; // Formato para Prometheus\n    const metric = `\n# HELP ${metricName} Help for ${key}\n# TYPE ${metricName} gauge\n${metricName}{fabricante=\"Ingeteam\",modelo=\"Ingecon Sun Storage 1 Play TL M\",origen=\"ModBus TCP/IP\"} ${value}\n    `;\n    metrics.push(metric); // Agregar la métrica al array\n}\n\n// Unir todas las métricas en una sola cadena\nmsg.payload = metrics.join(\"\\n\");\nreturn msg; // Retornar el mensaje principal con todas las métricas\n",
