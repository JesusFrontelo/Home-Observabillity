[Unit]
Description=Alertmanager

[Service]
User=prometheus
Group=prometheus
Type=simple
# Optional secrets file (keep out of Git)
EnvironmentFile=-/etc/default/alertmanager-secrets
ExecStart=/opt/alertmanager/alertmanager --config.file=/opt/alertmanager/alertmanager.yml --config.expand-env --storage.path=/opt/alertmanager/data/
Restart=on-failure
RestartSec=5s


[Install]
WantedBy=default.target
