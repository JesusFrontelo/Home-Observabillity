        "datasource": {
          "type": "prometheus",
          "uid": "000000001"
        },
        "editorMode": "code",
        "expr": "((node_memory_MemTotal_bytes{} - node_memory_MemFree_bytes{} - node_memory_Cached_bytes{}) / (node_memory_MemTotal_bytes{})) * 100",
