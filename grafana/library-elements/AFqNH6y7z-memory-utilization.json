      {
        "datasource": {
          "type": "prometheus",
          "uid": "000000001"
        },
        "expr": "((node_memory_Cached_bytes{instance=\"$server\"}) / (node_memory_MemTotal_bytes{instance=\"$server\"})) * 100",
        "format": "time_series",
        "intervalFactor": 1,
        "legendFormat": "Cached Memory",
        "refId": "C"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "000000001"
        },
        "editorMode": "code",
        "expr": "((node_memory_SwapTotal_bytes{instance=\"$server\"} - node_memory_SwapFree_bytes{instance=\"$server\"}) / (node_memory_SwapTotal_bytes{instance=\"$server\"}))  * 100",
        "format": "time_series",
        "intervalFactor": 1,
        "legendFormat": "Swap Memory",
        "range": true,
        "refId": "D"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "000000001"
        },
        "editorMode": "code",
        "exemplar": true,
        "expr": "((windows_cs_physical_memory_bytes{instance=\"$server\"} - windows_os_physical_memory_free_bytes{instance=\"$server\"}) / (windows_cs_physical_memory_bytes{instance=\"$server\"})) * 100",
        "hide": false,
        "interval": "",
        "legendFormat": "Used Memory",
        "range": true,
        "refId": "A"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "000000001"
        },
        "exemplar": true,
        "expr": "((windows_memory_cache_bytes{instance=\"$server\"}) / (windows_cs_physical_memory_bytes{instance=\"$server\"})) * 100",
        "hide": false,
        "interval": "",
        "legendFormat": "Cached Memory",
        "refId": "E"
      },
      {
        "datasource": {
